{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexFloatboard",
  "version": "0.8.0",
  "identifier": "local.codex.floatboard",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://127.0.0.1:4390", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
